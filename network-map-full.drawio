        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid border = built (in Terraform today)&lt;br&gt;Dashed border / &lt;font color='#C2410C'&gt;&lt;b&gt;PLANNED&lt;/b&gt;&lt;/font&gt; = not built yet&lt;br&gt;&lt;font color='#248814'&gt;&lt;b&gt;━&lt;/b&gt;&lt;/font&gt; user traffic (HTTP → NLB → pods)&lt;br&gt;&lt;font color='#8C2A96'&gt;&lt;b&gt;━&lt;/b&gt;&lt;/font&gt; database traffic (TCP 5432)&lt;br&gt;&lt;font color='#D86613'&gt;&lt;b&gt;┅&lt;/b&gt;&lt;/font&gt; outbound egress via NAT&lt;br&gt;&lt;b&gt;┅&lt;/b&gt; CI/CD and Terraform" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#F8F9FA;strokeColor=#AAB7B8;fontSize=11;fontColor=#232F3E;" parent="1" vertex="1">
